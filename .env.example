NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Server only: Supabase secret/service-role key for the protected Nightwatch scheduler.
# Never expose this with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=https://tidelight-two.vercel.app
NEXT_PUBLIC_SUPABASE_PASSKEYS_ENABLED=false
# Enable only after the Supabase email template displays its one-time code ({{ .Token }}).
NEXT_PUBLIC_SUPABASE_EMAIL_OTP_ENABLED=false
NEXT_PUBLIC_SUPABASE_GOOGLE_ENABLED=false
BITGET_QWEN_API_KEY=

# Server-only random 32+ character key for encrypting Bitget credentials (never expose with NEXT_PUBLIC_). Generate with: openssl rand -base64 32
BITGET_CREDENTIALS_ENCRYPTION_KEY=
